              "mode": "raw",
              "raw": "{\n  \"source\": \"Mumbai\",\n  \"destination\": \"Pune\",\n  \"distanceKm\": 155,\n  \"baseFare\": 275.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/routes/1",
