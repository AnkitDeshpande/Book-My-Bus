          }
        },
        {
          "name": "Deactivate Route (Admin)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/routes/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "routes", "1"]
            }
          }
        },
        {
          "name": "Get Route by ID",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/routes/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "routes", "1"]
            }
          }
        },
        {
          "name": "Get All Routes",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/routes?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "routes"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        }
      ]
    },
