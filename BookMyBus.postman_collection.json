            "url": {
              "raw": "{{baseUrl}}/api/v1/buses/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "buses", "1"]
            }
          }
        },
        {
          "name": "Get Bus by ID",
          "request": {
