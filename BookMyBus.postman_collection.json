          "name": "Create Route (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"Mumbai\",\n  \"destination\": \"Pune\",\n  \"distanceKm\": 150,\n  \"baseFare\": 250.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/routes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "routes"]
