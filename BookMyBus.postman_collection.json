              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Search Buses",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/buses/search?source=Mumbai&destination=Pune&seatCount=2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "buses", "search"],
              "query": [
                { "key": "source", "value": "Mumbai" },
                { "key": "destination", "value": "Pune" },
                { "key": "seatCount", "value": "2" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Bookings",
