            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": 1,\n  \"overallRating\": 5,\n  \"driverRating\": 4,\n  \"serviceRating\": 5,\n  \"comment\": \"Great journey, very comfortable!\"\n}"
