              "raw": "{\n  \"busNumber\": \"MH-01-AB-1234\",\n  \"busName\": \"Shivneri Express\",\n  \"driverName\": \"Ramesh Kumar\",\n  \"busType\": \"AC\",\n  \"totalSeats\": 40,\n  \"departureTime\": \"06:00:00\",\n  \"arrivalTime\": \"09:30:00\",\n  \"routeId\": 1\n}"
